{
  "name": "maidcentral-front-end",
  "private": true,
  "type": "module",
  "workspaces": [
    "capture",
    "server",
    "web"
  ],
  "scripts": {
    "capture": "npm start -w capture --",
    "catalog": "npm run catalog -w capture",
    "probe": "npm run probe -w capture --",
    "bundle-routes": "npm run bundle-routes -w capture",
    "test": "npm test -w capture && npm test -w server",
    "test:e2e": "npm run test:e2e -w capture",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "dev": "npm run dev -w server",
    "build": "npm run build -w web",
    "start": "node server/src/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  },
  "engines": {
    "node": ">=22"
  }
}
