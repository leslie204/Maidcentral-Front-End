# Local settings. Copy to .env (gitignored) and fill in. In the cloud session these are
# environment variables instead. Never commit real values.
# Wrap values containing # in single quotes, e.g. MC_PASSWORD='abc#123'.

# ---------- Capture tool (npm run capture) ----------
# The admin portal address you log into (https://<company>.maidcentral.com/).
# Kept out of the repo because the repo is public.
MC_PORTAL_URL=
# Your MaidCentral admin login, used only by the crawler.
MC_EMAIL=
MC_PASSWORD=

# ---------- Official API probe (npm run probe) ----------
# API user from Company > Settings > General > Integrations > API User.
MC_API_USERNAME=
MC_API_PASSWORD=
# Sandbox API user (api.maidcentral.net), if we have one. Used with --sandbox.
MC_SANDBOX_API_USERNAME=
MC_SANDBOX_API_PASSWORD=
